# MetIQ (LLM interno MetLife)
METIQ_USE_CASE_ID=<guid>
METIQ_ENDPOINT=https://int.internal2.apis.metlife.com/channel/metiq/webapi
METIQ_CLIENT_ID=innovation_api
METIQ_API_KEY=<api_key>
OCP_APIM_SUBSCRIPTION_KEY=<ocp_apim_subscription_key>

# Tools de Q&A (RAG) — cada domínio é um MetIQ potencialmente diferente,
# com seu próprio conjunto completo de parâmetros (nada é compartilhado
# entre eles, nem com o LLM principal do agente acima). CERT_BASE64 tem
# prioridade sobre CERT_PATH se ambos vierem preenchidos.

# Domínio: produtos (carências, coberturas, condições gerais)
QA_PRODUTOS_USE_CASE_ID=...
QA_PRODUTOS_CLIENT_ID=...
QA_PRODUTOS_ENDPOINT=...
QA_PRODUTOS_SUBSCRIPTION_KEY=...
QA_PRODUTOS_CERT_BASE64=
QA_PRODUTOS_CERT_PATH=
QA_PRODUTOS_CERT_PASSWORD=...
QA_PRODUTOS_CERT_SCOPE=...
QA_PRODUTOS_TENANT_ID=...

# Domínio: subscrição médica (aceitação por condição de saúde)
QA_SUBSCRICAO_MEDICA_USE_CASE_ID=...
QA_SUBSCRICAO_MEDICA_CLIENT_ID=...
QA_SUBSCRICAO_MEDICA_ENDPOINT=...
QA_SUBSCRICAO_MEDICA_SUBSCRIPTION_KEY=...
QA_SUBSCRICAO_MEDICA_CERT_BASE64=
QA_SUBSCRICAO_MEDICA_CERT_PATH=
QA_SUBSCRICAO_MEDICA_CERT_PASSWORD=...
QA_SUBSCRICAO_MEDICA_CERT_SCOPE=...
QA_SUBSCRICAO_MEDICA_TENANT_ID=...

# API do cotador (OAuth2 client_credentials via Microsoft/Azure AD)
COTADOR_TOKEN_URL=https://login.microsoftonline.com/<TENANT_ID>/oauth2/v2.0/token
COTADOR_CLIENT_ID=...
COTADOR_CLIENT_SECRET=...
COTADOR_SCOPE=api://<APP_ID>/.default
COTADOR_API_URL=https://sua-api-cotador.exemplo.com/cotacoes

# Headers extras exigidos pelo APIM/gateway do cotador
COTADOR_SUBSCRIPTION_KEY=...
COTADOR_USER_AGENT=Mozilla/5.0
COTADOR_ACCEPT=application/json;odata.metadata=minimal;odata.streaming=true
COTADOR_X_FORWARDED_FOR=...

# Autenticação via Client Assertion (certificado PFX) — compartilhada pelas
# APIs de sinistros e pagamentos (Brazil Data Hub System APIs). O JWT é
# gerado a cada renovação de token (expira em 2 min), nunca fica fixo.
# Use DATAHUB_PFX_BASE64 (conteúdo do .pfx em base64 — recomendado, funciona
# via Kubernetes Secret sem precisar montar volume) OU DATAHUB_PFX_PATH
# (caminho pro arquivo, útil só em dev local).
DATAHUB_PFX_BASE64=
DATAHUB_PFX_PATH=
DATAHUB_PFX_PASSWORD=...
DATAHUB_CLIENT_ID=...
DATAHUB_TENANT_ID=...
DATAHUB_SCOPE=api://.../.default
DATAHUB_SUBSCRIPTION_KEY=...
DATAHUB_X_FORWARDED_FOR=...

CLAIMS_API_URL=https://.../v1/BR/eosbrazilservices/claimsService/api/lifeClaim
PAYMENTS_API_URL=https://.../v1/BR/eosbrazilservices/paymentService/api/listInstallments
# Tamanho de página do loop de paginação de pagamentos. Confirmado que 10
# funciona; valores maiores (ex: 50) causaram 504 do Application Gateway
# em corretores com muitas parcelas. Aumente com cautela, testando antes.
PAYMENTS_PAGE_SIZE=10
